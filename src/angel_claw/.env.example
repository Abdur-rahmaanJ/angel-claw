# LLM Settings
MODEL=gpt-4o-mini
MODEL_KEY=your_api_key_here

# Gateway Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Memory Settings
MEMORY_PERSIST_DIR=./vaults

BRAVE_API_KEY=
TELEGRAM_TOKEN=
WHATSAPP_ENABLED=False

# MCP Settings
# JSON format for servers. Can be 'command' (stdio) or 'url' (sse).
# Example for local and remote (Zapier) servers:
MCP_SERVERS='{"everything": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-everything"]}, "zapier": {"url": "https://mcp.zapier.com/api/v1/connect"}}'

# JSON format for server authentication (especially for SSE).
# Get your Zapier MCP key from https://mcp.zapier.com/
MCP_AUTH='{"zapier": {"token": "YOUR_ZAPIER_MCP_API_KEY"}}'