# LLM Settings
MODEL=openai/gpt-4o-mini
MODEL_KEY=your_api_key_here
# Optional: Base URL for OpenAI-compatible API endpoints (e.g., for NVIDIA, LiteLLM proxy)
# MODEL_BASE_URL=https://integrate.api.nvidia.com/v1

# Gateway Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
# Optional: Secret key for webhook authentication (send as X-Webhook-Key header)
WEBHOOK_KEY=

# Memory Settings
MEMORY_PERSIST_DIR=./vaults

BRAVE_API_KEY=
TELEGRAM_TOKEN=
WHATSAPP_ENABLED=False

# MCP Settings
# JSON format for servers. Can be 'command' (stdio) or 'url' (sse).
# Example for local and remote (Zapier) servers:
MCP_SERVERS='{"everything": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-everything"]}, "zapier": {"url": "https://mcp.zapier.com/api/v1/connect"}}'

# JSON format for server authentication (especially for SSE).
# Get your Zapier MCP key from https://mcp.zapier.com/
MCP_AUTH='{"zapier": {"token": "YOUR_ZAPIER_MCP_API_KEY"}}'

# Email Settings (SMTP)
# For Gmail use: smtp.gmail.com, port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True

# Google Calendar Settings (Service Account)
# 1. Go to Google Cloud Console > IAM & Admin > Service Accounts
# 2. Create service account > Keys > Add JSON key
# 3. Download the JSON file
# 4. Place it as .angelclaw/service_account.json
# OR paste the JSON content directly in GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=